rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Keep this list in sync with src/allowedEmails.js. This is the rule
    // that actually protects your data — the check in the app UI is just
    // there to give a friendlier error message before someone even tries
    // to read or write.
    function isAllowed() {
      return request.auth != null &&
        request.auth.token.email in [
          'jpdehollain@gmail.com',
          'anaparismogna@gmail.com'
        ];
    }

    match /{document=**} {
      allow read, write: if isAllowed();
    }
  }
}
